<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Průvodce městem Trutnov | Příspěvky</title>
	<link rel="stylesheet" href="/styles.css">
    <title><%= titulek %></title>
</head>
<body>
	

    
    <header class="hlavicka">
		<div class="obal hlavicka-vnitr">
			<a class="logo" href="home.html" aria-label="Průvodce městem Trutnov">
				<span class="logo-znak">T</span>
				<span class="logo-text"><small>Průvodce městem</small>Trutnov</span>
			</a>
			<nav class="menu" aria-label="Hlavní navigace">
				<a href="/" aria-current="page">Home</a>
				<a href="/pamatky">Památky</a>
				<a href="/restaurace">Restaurace</a>
				<a href="/udalosti">Události</a>
				<a href="/doprava">Doprava</a>
				<a href="/kontakt">Kontakt</a>
                <a href="/prispevky">Příspěvky</a>
			</nav>
		</div>
        


	</header>
        <h1><%= titulek %></h1>

        <form action="/prispevky/new" method="post">
            <input type="text" name="nadpis" placeholder="Nadpis..." required /><br />
            <textarea name="obsah" placeholder="Obsah..." required></textarea><br />
            <input type="submit" value="Přidat příspěvek" />
        </form>
    <% if(typeof prispevky == 'undefined' || prispevky.length == 0) { %>
        <p><i>Dosud neexistují žádné příspěvky.</i></p>
    <% } else { %>
    <% for(let i = prispevky.length - 1; i >= 0; i--) { %>
        <div id="<%= prispevky[i].id %>">
            <p>
                <%= prispevky[i].nadpis %>
                <a href="posts/<%= prispevky[i].id %>">detail</a>
                <a href="posts/delete/<%= prispevky[i].id %>">smazat</a>
            </p>
        </div>
    <% }} %>

</body>    