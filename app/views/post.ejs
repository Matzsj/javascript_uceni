<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title><%= titulek %></title>
</head>
<body>
    <h1><%= titulek %></h1>
    <main>
        <header>
            <a href="/">Domů</a>

            <a href="/prispevky">Příspěvky</a>
            
            <a href="/users">Uživatelé</a>
        
            <a href="/about">O aplikaci</a>
        <hr />
    </header>
    
    <% if(typeof prispevek == 'undefined' || prispevek == false) { %>
        <p><i>Takový příspěvek neexistuje.</i></p>
    <% } else { %>
        <div id="<%= prispevek.id %>">
            <h2><%= prispevek.nadpis %></h2>
            <p><%= prispevek.obsah %></p>
            <p>Autor: <%= prispevek.autor || 'Neznámý autor' %></p>
        </div>
        <% if (prispevek.autor === autorAktualni) { %>
            <form action="/prispevky/delete/<%= prispevek.id %>" method="post">
                <button type="submit">Smazat příspěvek</button>
            </form>
        <% } %>
    <% } %>
    <a href="/prispevky">Zpět</a>
</body>
</html>